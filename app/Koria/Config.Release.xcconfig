// Release (TestFlight / App Store) build settings. Config.Debug.xcconfig stays
// on the local stack. The publishable key ships in the binary and is safe to
// commit; never put a service-role or secret key here.
//
// API_BASE_URL / SUPABASE_URL need the https:/$()/ trick so xcode doesn't treat // as a comment.
API_BASE_URL = https:/$()/app.flykoria.com
SUPABASE_URL = https:/$()/tjyofeqzpggmcwsxnplj.supabase.co
SUPABASE_ANON_KEY = sb_publishable_2-2yOZKINa46wY51mgpSaQ_gDIZaXf_
USE_MOCK = NO

# Host secrets (Vercel). Do not commit real values.

# Public origin for operator emails, invite links, and auth redirects.
# NEXT_PUBLIC_SITE_URL=https://app.flykoria.com

# Transactional mail via Resend. Leave both unset locally: sendEmail logs
# email_skipped and does not call the provider. The from-address is on
# notify.flykoria.com so hello@flykoria.com stays on the apex mailbox.
# RESEND_API_KEY=
# EMAIL_FROM=KORIA <notifications@notify.flykoria.com>

# Wire instructions printed on the invoice. JSON object; required in production.
# KORIA_BANK_DETAILS_JSON={"bank_name":"Example Bank","account_name":"KORIA LLC"}

# Sentry DSN. Server-side error reporting is off when this is unset.
# SENTRY_DSN=
# Events are tagged with environment and release. On Vercel these default to
# VERCEL_ENV and VERCEL_GIT_COMMIT_SHA; set these to override elsewhere.
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=

# Set to 1 to boot production without RESEND_API_KEY and EMAIL_FROM.
# KORIA_ALLOW_NO_EMAIL=1
